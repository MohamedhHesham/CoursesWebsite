@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center my-5">
    <div class="col-lg-8">
        <div class="card shadow-sm border p-4 p-md-5 text-center">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill display-2"></i>
            </div>
            <h2 class="fw-bold text-danger mb-2">Something went wrong</h2>
            <p class="text-muted mb-4">An error occurred while processing your request.</p>

            @if (Model != null && Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded text-start mb-4">
                    <span class="text-muted small">Request ID:</span>
                    <code class="text-dark fw-bold">@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
            </div>
        </div>
    </div>
</div>

