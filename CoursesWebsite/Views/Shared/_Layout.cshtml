<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduCourse</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CoursesWebsite.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom py-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
                    <span>EduCourse</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courses" asp-action="Index">
                                <i class="bi bi-collection-play me-1"></i> All Courses
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @{
                            var userId = Context.Session.GetString("UserId");
                            var role = Context.Session.GetString("Role");
                            var firstName = Context.Session.GetString("FirstName");
                        }

                        @if (!string.IsNullOrEmpty(userId))
                        {
                            @if (role == "admin")
                            {
                                <li class="nav-item me-lg-2">
                                    <a class="nav-link text-primary fw-semibold" asp-controller="Courses" asp-action="AdminPanel">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                                    </a>
                                </li>
                            }
                            <li class="nav-item me-lg-2">
                                <a class="nav-link fw-semibold" asp-controller="User" asp-action="Account">
                                    <i class="bi bi-person-circle me-1 text-primary"></i> @(firstName != null ? firstName : "My Account")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-semibold" asp-controller="User" asp-action="Logout" title="Log out">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-lg-2">
                                <a class="nav-link" asp-controller="User" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-controller="User" asp-action="Register">
                                    Get Started
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill text-primary fs-5"></i>
                <span class="fw-bold text-dark">EduCourse</span>
                <span class="text-muted">| Empowering learners worldwide</span>
            </div>
            <div class="text-muted">
                &copy; @DateTime.Now.Year EduCourse Platform. All rights reserved. &bull;
                <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none hover-primary ms-1">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

