@model Course

@{
    ViewData["Title"] = "Enroll - " + Model.Name;
}

<div class="row g-4 align-items-start my-2">
    <!-- Course Details (Left Column) -->
    <div class="col-lg-8">
        <div class="card shadow-sm border overflow-hidden p-0 mb-4">
            <div style="height: 320px; background-color: #0f172a; overflow: hidden;">
                <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/Images/No_Image.png" : Model.ImagePath)" 
                     alt="@Model.Name" 
                     class="w-100 h-100"
                     style="object-fit: cover;"
                     onerror="this.src='/Images/No_Image.png';" />
            </div>
            <div class="p-4 p-md-5">
                <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-2">Featured Course</span>
                <h1 class="fw-bold mb-3">@Model.Name</h1>
                <p class="lead text-muted mb-4" style="white-space: pre-line;">@Model.Description</p>

                <div class="border-top pt-4">
                    <h5 class="fw-bold mb-3">What You Will Learn</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <span>Structured step-by-step video lessons</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <span>Practical hands-on walkthroughs</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <span>Track your progress as you complete lessons</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <span>Lifetime access to course materials</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrollment Card (Right Column) -->
    <div class="col-lg-4">
        <div class="card shadow-sm border p-4 sticky-top" style="top: 100px;">
            <h4 class="fw-bold mb-3">Course Enrollment</h4>
            
            <div class="d-flex align-items-baseline gap-2 mb-4">
                <span class="display-6 fw-bold text-primary">Free</span>
                <span class="text-muted small">/ Unlimited Access</span>
            </div>

            <ul class="list-unstyled mb-4 text-muted small">
                <li class="mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-play-btn text-primary"></i> On-demand video content
                </li>
                <li class="mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-phone text-primary"></i> Mobile and desktop accessible
                </li>
                <li class="mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-award text-primary"></i> Certificate of completion
                </li>
            </ul>

            <form asp-controller="Enrollments" asp-action="Enroll" method="post">
                <input type="hidden" asp-for="Id" value="@Model.Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-warning small py-2 mb-3" role="alert"></div>
                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm py-3 fw-bold">
                    <i class="bi bi-mortarboard-fill me-2"></i> Enroll Now
                </button>
            </form>

            <p class="text-center text-muted small mt-3 mb-0">
                <i class="bi bi-shield-check me-1"></i> Instant access after enrollment
            </p>
        </div>
    </div>
</div>
</html>