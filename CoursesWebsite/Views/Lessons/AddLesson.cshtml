@model Lesson

@{
    ViewData["Title"] = "Add Lesson";
}

<div class="row justify-content-center my-3">
    <div class="col-lg-8">
        <div class="mb-3">
            <a asp-controller="Lessons" asp-action="Index" asp-route-Id="@ViewBag.CourseId" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Back to Lessons
            </a>
        </div>

        <div class="card shadow-sm border p-4 p-md-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="feature-icon mb-0" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Add New Lesson</h3>
                    <p class="text-muted small mb-0">Attach video lectures and supplemental study notes.</p>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="CourseId" value="@ViewBag.CourseId" />
                <input type="hidden" asp-for="Id" value="@ViewBag.CourseId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Lesson Title</label>
                    <input type="text" asp-for="Name" class="form-control" placeholder="e.g. Introduction to Entity Framework Core" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TextContent" class="form-label">Lesson Notes / Text Content</label>
                    <textarea asp-for="TextContent" class="form-control" rows="5" 
                              placeholder="Write detailed explanations, key takeaways, or code snippets for this lesson..."></textarea>
                    <span asp-validation-for="TextContent" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Video" class="form-label">Lesson Video File (.mp4, .mov, etc.)</label>
                    <input type="file" asp-for="Video" accept=".mp4,.avi,.mov,.webm,.mkv,.flv,.wmv" class="form-control" />
                    <span asp-validation-for="Video" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                    <a asp-controller="Lessons" asp-action="Index" asp-route-Id="@ViewBag.CourseId" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2 me-1"></i> Add Lesson
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</html>