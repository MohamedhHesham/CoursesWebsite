@model List<Lesson>

@{
    ViewData["Title"] = "Course Lessons Management";
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <a asp-controller="Courses" asp-action="AdminPanel" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Courses
        </a>
        <h2 class="fw-bold mt-2 mb-0">Course Curriculum & Lessons</h2>
        <p class="text-muted mb-0">Manage all lesson modules and video lectures for this course.</p>
    </div>
    <div>
        <a asp-controller="Lessons" asp-action="AddLesson" asp-route-id="@ViewBag.CourseId" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Lesson
        </a>
    </div>
</div>

<!-- Lessons Grid/List -->
@if (Model != null && Model.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (Lesson lesson in Model)
        {
            <div class="card shadow-sm border p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-4 col-lg-3">
                        @if (!string.IsNullOrEmpty(lesson.VideoPath))
                        {
                            <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm bg-dark">
                                <video src="@lesson.VideoPath" controls class="w-100 h-100"></video>
                            </div>
                        }
                        else
                        {
                            <div class="ratio ratio-16x9 rounded bg-light d-flex align-items-center justify-content-center text-muted border">
                                <span class="small"><i class="bi bi-camera-video-off me-1"></i> No Video</span>
                            </div>
                        }
                    </div>

                    <div class="col-md-8 col-lg-9">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill small fw-semibold mb-1">
                                    Lesson @lesson.LessonNumber
                                </span>
                                <h5 class="fw-bold text-dark mb-1">@lesson.Name</h5>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a asp-controller="Lessons" asp-action="LessonPage" asp-route-Id="@lesson.Id" 
                                   class="btn btn-sm btn-outline-primary" target="_blank" title="Preview Lesson">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Preview
                                </a>
                                <form method="post" asp-controller="Lessons" asp-action="DeleteLesson" asp-route-id="@lesson.Id" 
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete lesson &quot;@lesson.Name&quot;?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Lesson">
                                        <i class="bi bi-trash3 me-1"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                        <p class="text-muted small mb-0 text-truncate" style="max-width: 650px;">
                            @(string.IsNullOrEmpty(lesson.TextContent) ? "No text content provided." : lesson.TextContent)
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-5 text-center shadow-sm">
        <i class="bi bi-collection-play display-1 text-muted opacity-50 mb-3 d-block"></i>
        <h4 class="fw-bold">No lessons added yet</h4>
        <p class="text-muted mb-4">Create your first lesson to build out this course's curriculum.</p>
        <div>
            <a asp-controller="Lessons" asp-action="AddLesson" asp-route-id="@ViewBag.CourseId" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add First Lesson
            </a>
        </div>
    </div>
}
</html>