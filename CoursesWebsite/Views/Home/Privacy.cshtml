@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <h1 class="fw-bold mb-3"><i class="bi bi-shield-lock text-primary me-2"></i>Privacy Policy</h1>
            <p class="text-muted">Last updated: September 2026</p>
            <hr class="my-4" />

            <h4 class="fw-bold">1. Information We Collect</h4>
            <p class="text-secondary">
                We collect information you provide directly to us when you create an account, enroll in courses, track your learning progress, and interact with our course materials.
            </p>

            <h4 class="fw-bold mt-4">2. How We Use Your Information</h4>
            <p class="text-secondary">
                Your data is utilized to personalize your learning experience, maintain your course progression, secure your credentials, and continuously enhance our platform offerings.
            </p>

            <h4 class="fw-bold mt-4">3. Data Security</h4>
            <p class="text-secondary">
                We implement appropriate security practices to protect your personal information against unauthorized access, alteration, or disclosure.
            </p>

            <div class="mt-4 pt-3 border-top">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

