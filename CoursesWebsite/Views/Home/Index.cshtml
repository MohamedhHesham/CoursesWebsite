@{
    ViewData["Title"] = "Unlock Your Potential with Modern Courses";
}

<!-- Hero Section -->
<div class="hero-section text-center text-md-start">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-semibold mb-3 shadow-sm">
                <i class="bi bi-stars me-1"></i> Accelerate Your Career
            </span>
            <h1 class="hero-title mb-3" style="color:antiquewhite">Master New Skills with Premium Online Courses</h1>
            <p class="lead text-light opacity-75 mb-4">
                Explore a vast catalog of structured courses taught by industry professionals. Learn at your own pace, anytime and anywhere.
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start">
                <a asp-controller="Courses" asp-action="Index" class="btn btn-light btn-lg text-primary fw-bold px-4 shadow-sm">
                    <i class="bi bi-search me-2"></i> Explore Courses
                </a>
                <a asp-controller="User" asp-action="Register" class="btn btn-outline-light btn-lg px-4">
                    Join for Free
                </a>
            </div>
        </div>
        <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="p-4">
                <i class="bi bi-laptop display-1 text-white opacity-75"></i>
            </div>
        </div>
    </div>
</div>


<!-- Call to action card -->
<div class="card bg-white border p-5 text-center my-5 shadow-sm">
    <div class="col-lg-8 mx-auto">
        <h2 class="fw-bold mb-3">Ready to begin your learning journey?</h2>
        <p class="text-muted mb-4">Start exploring today and unlock new opportunities for your personal and professional growth.</p>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg px-5">
            Browse All Courses <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</div>

