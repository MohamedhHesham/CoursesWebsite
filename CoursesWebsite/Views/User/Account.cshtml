@model User

@{
    ViewData["Title"] = "My Profile & Courses";
    var enrolledCount = Model?.Enrollments?.Count ?? 0;
    var initials = (!string.IsNullOrEmpty(Model?.FirstName) ? Model.FirstName[0].ToString() : "") +
                   (!string.IsNullOrEmpty(Model?.LastName) ? Model.LastName[0].ToString() : "");
}

<!-- Profile Header Card -->
<div class="card shadow-sm border p-4 p-md-5 mb-5 bg-white">
    <div class="row align-items-center g-4">
        <div class="col-md-8 d-flex align-items-center gap-4">
            <div class="avatar-circle">
                @(string.IsNullOrEmpty(initials) ? "U" : initials.ToUpper())
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h2 class="fw-bold mb-0 text-dark">@Model?.FirstName @Model?.LastName</h2>
                    <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill small fw-semibold">
                        @(Model?.Role ?? "Student")
                    </span>
                </div>
                <p class="text-muted mb-0">
                    <i class="bi bi-envelope me-1"></i> @Model?.Email
                </p>
            </div>
        </div>

        <div class="col-md-4 text-md-end">
            <div class="d-inline-block bg-light border rounded-4 p-3 text-center" style="min-width: 170px;">
                <span class="display-6 fw-bold text-primary d-block">@enrolledCount</span>
                <span class="text-muted small fw-semibold">Enrolled Courses</span>
            </div>
        </div>
    </div>
</div>

<!-- Enrolled Courses Section -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">My Learning Dashboard</h3>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-lg me-1"></i> Explore More Courses
        </a>
    </div>
</div>

@if (Model?.Enrollments != null && Model.Enrollments.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (Enrollment enrollment in Model.Enrollments)
        {
            if (enrollment.Course != null)
            {
                <div class="col">
                    <div class="card card-hover h-100 d-flex flex-column border">
                        <div class="card-img-wrapper">
                            <img src="@(string.IsNullOrEmpty(enrollment.Course.ImagePath) ? "/Images/No_Image.png" : enrollment.Course.ImagePath)" 
                                 alt="@enrollment.Course.Name" 
                                 onerror="this.src='/Images/No_Image.png';" />
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-2">@enrollment.Course.Name</h5>
                            <p class="card-text text-muted small flex-grow-1 mb-4" 
                               style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @enrollment.Course.Description
                            </p>
                            <a asp-controller="Courses" asp-action="OpenCourse" asp-route-Id="@enrollment.CourseId" 
                               class="btn btn-primary w-100 mt-auto">
                                <i class="bi bi-play-circle me-1"></i> Continue Learning
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}
else
{
    <div class="card p-5 text-center shadow-sm">
        <div class="py-4">
            <i class="bi bi-book display-1 text-muted opacity-50 mb-3 d-block"></i>
            <h4 class="fw-bold">You are not enrolled in any courses yet</h4>
            <p class="text-muted mb-4">Start your educational journey by browsing our course catalog.</p>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-search me-1"></i> Browse Courses
            </a>
        </div>
    </div>
}
</html>