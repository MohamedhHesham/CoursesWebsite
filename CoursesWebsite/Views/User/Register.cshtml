@model User

@{
    ViewData["Title"] = "Create an Account";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.6rem;">
                    <i class="bi bi-person-plus"></i>
                </div>
                <h3 class="fw-bold mb-1">Create an Account</h3>
                <p class="text-muted small">Join our community and start advancing your skills today.</p>
            </div>

            <form asp-action="Register" method="post" asp-controller="User">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Role" value="user" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label">First Name</label>
                        <input type="text" asp-for="FirstName" class="form-control" placeholder="John" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <input type="text" asp-for="LastName" class="form-control" placeholder="Doe" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" asp-for="Email" class="form-control border-start-0 ps-0" 
                               placeholder="you@example.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="password" asp-for="Password" class="form-control border-start-0 ps-0" 
                               placeholder="Create a strong password" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3 fw-semibold shadow-sm">
                    Create Account <i class="bi bi-arrow-right ms-1"></i>
                </button>

                <div class="text-center">
                    <span class="text-muted small">Already have an account?</span>
                    <a asp-action="Login" asp-controller="User" class="fw-semibold text-primary small text-decoration-none ms-1">
                        Log in here
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</html>