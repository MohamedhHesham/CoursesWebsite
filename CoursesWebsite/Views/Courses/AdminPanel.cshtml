@model List<Course>

@{
    ViewData["Title"] = "Courses Admin Panel";
}

<!-- Admin Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold">Admin Mode</span>
        </div>
        <h2 class="fw-bold mt-2 mb-0">Course Management</h2>
        <p class="text-muted mb-0">Create, edit, and organize courses and curricula.</p>
    </div>
    <div>
        <a asp-controller="Courses" asp-action="AddCourse" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Course
        </a>
    </div>
</div>

<!-- Courses Admin List -->
@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 100px;">Preview</th>
                        <th scope="col">Course Details</th>
                        <th scope="col" class="text-end pe-4" style="width: 280px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Course course in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(course.ImagePath) ? "/Images/No_Image.png" : course.ImagePath)" 
                                     alt="@course.Name" 
                                     class="rounded"
                                     style="width: 80px; height: 55px; object-fit: cover;"
                                     onerror="this.src='/Images/No_Image.png';" />
                            </td>
                            <td>
                                <h6 class="fw-bold mb-1 text-dark">@course.Name</h6>
                                <p class="text-muted small mb-0 text-truncate" style="max-width: 500px;">
                                    @course.Description
                                </p>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id" 
                                       class="btn btn-sm btn-outline-primary" title="Edit Course Details">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>
                                    <a asp-controller="Lessons" asp-action="Index" asp-route-Id="@course.Id" 
                                       class="btn btn-sm btn-outline-secondary" title="Manage Lessons">
                                        <i class="bi bi-collection-play me-1"></i> Lessons
                                    </a>
                                    <form method="post" asp-controller="Courses" asp-action="DeleteCourse" asp-route-id="@course.Id" 
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete &quot;@course.Name&quot;?\n\nThis will permanently delete the course, all its lessons, videos, and student enrollments.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Course">
                                            <i class="bi bi-trash3 me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card p-5 text-center shadow-sm">
        <div class="py-4">
            <i class="bi bi-folder-plus display-1 text-muted opacity-50 mb-3 d-block"></i>
            <h4 class="fw-bold">No courses created yet</h4>
            <p class="text-muted mb-4">Get started by creating your very first course.</p>
            <a asp-controller="Courses" asp-action="AddCourse" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add Course
            </a>
        </div>
    </div>
}
</html>