@model List<Course>

@{
    ViewData["Title"] = "Explore Courses";
}

<!-- Header & Search Bar -->
<div class="mb-5 text-center">
    <h1 class="fw-bold mb-2">Explore Our Courses</h1>
    <p class="text-muted mb-4">Discover a wide range of topics and gain practical expertise.</p>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <form method="get" asp-controller="Courses" asp-action="Index">
                <div class="input-group shadow-sm rounded-pill overflow-hidden bg-white border p-1">
                    <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control border-0 shadow-none px-2"
                           placeholder="Search courses by title or topic..." value="@ViewBag.currentSearch" />
                    @if (!string.IsNullOrEmpty(ViewBag.currentSearch as string))
                    {
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-link text-muted border-0 text-decoration-none">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Search</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Courses Grid -->
@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (Course course in Model)
        {
            <div class="col">
                <div class="card card-hover h-100 d-flex flex-column border">
                    <div class="card-img-wrapper">
                        <img src="@(string.IsNullOrEmpty(course.ImagePath) ? "/Images/No_Image.png" : course.ImagePath)" 
                             alt="@course.Name" 
                             onerror="this.src='/Images/No_Image.png';" />
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold text-dark mb-2">@course.Name</h5>
                        <p class="card-text text-muted flex-grow-1 mb-4" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @course.Description
                        </p>
                        <a asp-controller="Enrollments" asp-action="Index" asp-route-Id="@course.Id" class="btn btn-primary w-100 mt-auto">
                            Take The Course <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-5 text-center my-5 shadow-sm border-0">
        <div class="py-4">
            <i class="bi bi-journal-x display-1 text-muted opacity-50 mb-3 d-block"></i>
            <h4 class="fw-bold">No courses found</h4>
            <p class="text-muted">
                @if (!string.IsNullOrEmpty(ViewBag.currentSearch as string))
                {
                    <span>We couldn't find any courses matching "<strong>@ViewBag.currentSearch</strong>".</span>
                }
                else
                {
                    <span>There are currently no courses available. Check back soon!</span>
                }
            </p>
            @if (!string.IsNullOrEmpty(ViewBag.currentSearch as string))
            {
                <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary mt-2">
                    Clear Search
                </a>
            }
        </div>
    </div>
}
</html>